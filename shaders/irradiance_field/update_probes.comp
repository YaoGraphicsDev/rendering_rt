#version 460
#extension GL_EXT_samplerless_texture_functions : require
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_image_load_formatted : require

// One workgroup per probe.
// 256 threads is enough for:
// irradiance -- 8x8 interior, 10x10 tile
// depth -- 16x16 interior, 18x18 tile
layout(local_size_x = 256) in;

#define ATLAS_TYPE_IRRADIANCE 0
#define ATLAS_TYPE_DEPTH      1

#define UPDATE_IRRADIANCE   0
#define UPDATE_DEPTH        1
layout (push_constant) uniform PushConstants {
    int probeSize;
    int probeCount; // total
    ivec2 atlasSize; // width, height
    int raysPerProbe;
    float probeMaxDistance;
    float depthSharpness; // See IrradianceField.h depthSharpness
    float hysteresis;     // See IrradianceField.h hysteresis
    uint updateType; // 0 -- irradiance, 1 -- depth moments. Had to do it this way because irradiance and depth atlases have different dimensions. Cant write to both in one shader
    uint srcAtlasIndex; // 0, 1
} consts;

// Set 3: Managed by framegraph
//  binding 0 - 15:     textures
//  binding 16 - 23:    SSBO
//  binding 24 - 31:    storage image
layout(set = 3, binding = 0) uniform texture2D texRayOrigins;
layout(set = 3, binding = 1) uniform texture2D texRayDirections;
layout(set = 3, binding = 2) uniform texture2D texRayHitLocations;
layout(set = 3, binding = 3) uniform texture2D texRayHitRadiance;
layout(set = 3, binding = 4) uniform texture2D texRayHitNormals;

layout(set = 3, binding = 24) uniform image2D imgAtlas0;
layout(set = 3, binding = 25) uniform image2D imgAtlas1;

#include "math_utils.glsl" //! #include "../common/math_utils.glsl"

#define MAX_PROBE_SIZE 32
shared vec4 sharedInterior[MAX_PROBE_SIZE][MAX_PROBE_SIZE];

vec2 normalizedOctCoordFromInteriorTexel(ivec2 interiorTexel, int probeSize) {
    // interiorPixel is [0, N - 1]
    return (vec2(interiorTexel) + vec2(0.5)) * (2.0 / float(probeSize)) - vec2(1.0);
}

ivec2 probeTileBase(uint probeID, ivec2 atlasSize, int probeSize) {
    int tileSize = probeSize + 2;
    int probesPerRow = (atlasSize.x - 2) / tileSize;

    ivec2 tileCoord = ivec2(
        int(probeID) % probesPerRow,
        int(probeID) / probesPerRow
    );

    // +1 for global atlas border
    return ivec2(1) + tileCoord * tileSize;
}

const float epsilon = 1e-6;

vec4 updateOneInteriorTexel(uint probeID, ivec2 interiorTexel) {
    vec3 texelDirection = octDecode(normalizedOctCoordFromInteriorTexel(interiorTexel, consts.probeSize));
    const float energyConservation = 1.0; // TODO: what's this? Perhaps to prevent multibounce feedback from amplifying itself?

    // For each ray
    vec4 result = vec4(0.0);
	for (int r = 0; r < consts.raysPerProbe; ++r) {
		ivec2 C = ivec2(r, probeID);

		vec3 rayDirection = texelFetch(texRayDirections, C, 0).xyz;
        vec3 rayHitRadiance = texelFetch(texRayHitRadiance, C, 0).xyz * energyConservation;
		vec3 rayHitLocation = texelFetch(texRayHitLocations, C, 0).xyz;

        vec3 probeLocation = texelFetch(texRayOrigins, C, 0).xyz;
        // Will be zero on a miss
		vec3 rayHitNormal = texelFetch(texRayHitNormals, C, 0).xyz;

        rayHitLocation += rayHitNormal * 0.01f; // TODO: why?

         // maxDistance should be slightly larger than probe grid cell diagonal length
         // see IrradianceField.cpp m_maxDistance
		float rayProbeDistance = min(consts.probeMaxDistance, length(probeLocation - rayHitLocation));
        
        // Detect misses and force depth
		if (dot(rayHitNormal, rayHitNormal) < epsilon) {
            rayProbeDistance = consts.probeMaxDistance;
        }

        float weight = max(0.0, dot(texelDirection, rayDirection)); // cosine weight for irradiance
        if (consts.updateType == UPDATE_IRRADIANCE) {
            if (weight >= epsilon) {
                result += vec4(rayHitRadiance * weight, weight);
            }
        } else { // update depth
            weight = pow(weight, consts.depthSharpness);
            if (weight >= epsilon) {
                result += vec4(rayProbeDistance * weight, rayProbeDistance * rayProbeDistance * weight, 0.0, weight);
            }
        }
    }

    // conceptually, weight sum (w component) smaller than epsilon is unlikely if ray directions are sampled uniformly from a spherical surface
    // but with depthSharpness, cosine lobe turns thin, so small weight sum is more likely to happen to depth than irradiance.
    // Also, if the sampling process is true random, it is possible that sampled rays directions all point away from a specific octo surface direction,
    // which results in w smaller that epsilon
    if (result.a > epsilon) {
        result.xyz /= result.w;
        // result.w = 1.0 - consts.hysteresis;
    }

    return result;
}

bool isTileCorner(ivec2 local, int N) {
    bool left =     local.x == 0;
    bool right =    local.x == N + 1;
    bool top =      local.y == 0;
    bool bottom =   local.y == N + 1;

    return (left || right) && (top || bottom);
}

bool isTileBorder(ivec2 local, int N) {
    return local.x == 0 || local.x == N + 1 ||
           local.y == 0 || local.y == N + 1;
}

ivec2 octFoldedBorderSource(ivec2 local, int N) {
    // Input local is in [0, N + 1].
    // Return interior coordinate in [0, N - 1].
    ivec2 s = local;

    bool left   = local.x == 0;
    bool right  = local.x == N + 1;
    bool top    = local.y == 0;
    bool bottom = local.y == N + 1;

    // Work in local tile coords where interior is [1, N].
    if (left) {
        s.x = 1;
        s.y = N + 1 - local.y;
    }
    else if (right) {
        s.x = N;
        s.y = N + 1 - local.y;
    }

    if (top) {
        s.y = 1;
        s.x = N + 1 - s.x;
    }
    else if (bottom) {
        s.y = N;
        s.x = N + 1 - s.x;
    }

    s = clamp(s, ivec2(1), ivec2(N));

    // Convert from local tile coords [1, N] to shared coords [0, N - 1].
    return s - ivec2(1);
}

vec4 averageOctCorners(int N) {
    return 0.25 * (
        sharedInterior[0][0] +
        sharedInterior[0][N - 1] +
        sharedInterior[N - 1][0] +
        sharedInterior[N - 1][N - 1]
    );
}

void main()
{
    uint probeID = gl_WorkGroupID.x;

    if (probeID >= uint(consts.probeCount)) {
        return;
    }

    uint texelID = gl_LocalInvocationIndex;
    int N = consts.probeSize;

    // compute interior N x N texels into shared memory.
    int interiorTexelCount = N * N;
    ivec2 tileBase = probeTileBase(probeID, consts.atlasSize, N);

    for (uint i = texelID; i < uint(interiorTexelCount); i += gl_WorkGroupSize.x) { // in case number of texels per probe exceeds local thread count
        ivec2 interiorTexel = ivec2(
            int(i) % N,
            int(i) / N
        );

        vec4 current = updateOneInteriorTexel(probeID, interiorTexel);

        ivec2 atlasTexel = tileBase + interiorTexel + ivec2(1); // account for local border
        vec4 previous = vec4(0.0);
        if (consts.srcAtlasIndex == 0) {
            previous = imageLoad(imgAtlas0, atlasTexel);
        } else if (consts.srcAtlasIndex == 1) {
            previous = imageLoad(imgAtlas1, atlasTexel);
        } else {
            // error: magenta
            previous = vec4(1.0, 0.0, 1.0, 1.0);
        }

        sharedInterior[interiorTexel.y][interiorTexel.x] = mix(current, previous, consts.hysteresis);
    }

    barrier();

    // write full tile: interior + local oct-aware border.
    int tileSize = N + 2;
    int tileTexelCount = tileSize * tileSize;

    for (uint i = texelID; i < uint(tileTexelCount); i += gl_WorkGroupSize.x) {
        ivec2 local = ivec2(
            int(i) % tileSize,
            int(i) / tileSize
        );

        vec4 value;

        if (!isTileBorder(local, N)) {
            // inner texel
            ivec2 inner = local - ivec2(1);
            value = sharedInterior[inner.y][inner.x];
        }
        else if (isTileCorner(local, N)) {
            // corner texel
            value = averageOctCorners(N);
        }
        else {
            // edge texel
            ivec2 src = octFoldedBorderSource(local, N);
            value = sharedInterior[src.y][src.x];
        }

        if (consts.srcAtlasIndex == 0) {
            imageStore(imgAtlas1, tileBase + local, value);
        } else if (consts.srcAtlasIndex == 1) {
            imageStore(imgAtlas0, tileBase + local, value);
        } else {
            // error: magenta
            imageStore(imgAtlas1, tileBase + local, vec4(1.0, 0.0, 1.0, 1.0));
        }
    }
}